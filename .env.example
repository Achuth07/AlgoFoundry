# AlgoFoundry environment.
# Copy to .env and edit. Most runtime settings live in the web GUI (stored in SQLite);
# these are only the bootstrap values used on first launch.

# Web GUI / server
ALGOFOUNDRY_HOST=127.0.0.1
ALGOFOUNDRY_PORT=8000

# Initial admin login for the GUI (seeds the first account on first run — change these!).
# After first launch, accounts live in the database; sign in at /login.
ALGOFOUNDRY_USER=admin
ALGOFOUNDRY_PASSWORD=change-me-now

# Registration code required to create new accounts at /signup. Leave blank to
# disable sign-up entirely (you can also set/change it in the GUI > Settings).
ALGOFOUNDRY_SIGNUP_CODE=

# Set to 1 only when the GUI is served over HTTPS — adds the Secure flag to the
# session cookie. Leave blank for plain-HTTP localhost / tunnel setups.
ALGOFOUNDRY_COOKIE_SECURE=

# Shared secret that TradingView must include in every webhook payload.
# If left blank, a random one is generated on first run (see the GUI > Settings).
ALGOFOUNDRY_WEBHOOK_SECRET=

# SQLite database location
ALGOFOUNDRY_DB=algofoundry.db
